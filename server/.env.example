# ──────────────────────────────────────────────────────────────────────────────
# OpenAssistant Server 配置示例（复制为 server/.env 后修改）
# 所有变量都以 OA_ 开头，环境变量优先级高于 .env
# ──────────────────────────────────────────────────────────────────────────────

# 基础
OA_ENVIRONMENT=development
OA_DEBUG=false
OA_PUBLIC_BASE_URL=http://192.168.1.10:8000
# 服务器默认时区（IANA 名称）：新建用户默认使用它，user.timezone 为空时也用它兜底；
# 写在 .env 里即视为显式配置，重启后会把已有用户的时区同步为该值。
# 可选值示例：Asia/Shanghai、UTC、America/New_York
OA_TIMEZONE=Asia/Shanghai

# 数据库：SQLite（默认，适合个人部署）或 PostgreSQL
# OA_DATABASE_URL=sqlite:///./data/openassistant.db
# OA_DATABASE_URL=postgresql+psycopg://openassistant:password@localhost:5432/openassistant

# 对象存储（音频文件）
OA_STORAGE_DIR=./data/storage

# 认证
# 生成 API Key：python -m app.cli create-user --name 小明
# 若设置下面的值，服务启动时会自动创建/复用该 Key 对应的用户（仅开发用）
OA_BOOTSTRAP_API_KEY=
OA_BOOTSTRAP_USER_NAME=我
OA_API_KEY_PEPPER=change-me-in-production

# ── Providers ─────────────────────────────────────────────────────────────────
# auto：检测到依赖/密钥就用真实实现，否则自动降级（mock/rule/energy/spectral）
OA_ASR_PROVIDER=auto
OA_DIARIZATION_PROVIDER=auto
OA_SPEAKER_PROVIDER=auto
OA_LLM_PROVIDER=auto
OA_SEARCH_PROVIDER=auto
OA_PUSH_PROVIDER=auto

# ASR（默认 FunASR：Paraformer-zh + FSMN-VAD + CT-Punc）
OA_FUNASR_MODEL=paraformer-zh
# 内置 VAD / 标点模型；片段已由 Server 切分，留空可关闭内置 VAD 加快速度
OA_FUNASR_VAD_MODEL=fsmn-vad
OA_FUNASR_PUNC_MODEL=ct-punc
# cuda / cuda:0 / cpu；GPU 不可用时自动回退 CPU
OA_FUNASR_DEVICE=cuda
# 模型来源：ms（ModelScope，国内推荐）/ hf（HuggingFace）
OA_FUNASR_HUB=ms
# SenseVoice 使用的语言（auto 自动识别）；Paraformer-zh 固定中文
OA_FUNASR_LANGUAGE=zh
# 逆文本正则化：把"下午三点"等口语转成书面数字/日期
OA_FUNASR_USE_ITN=true
# 热词表（空格分隔），提升人名/专有名词识别率，例如：周磊 三号会议室 Q3
OA_FUNASR_HOTWORD=
# 长音频分批秒数（片段通常远小于该值）
OA_FUNASR_BATCH_SIZE_S=300

# 可选回退：老部署可通过 OA_ASR_PROVIDER=faster_whisper 继续使用 faster-whisper
# OA_ASR_PROVIDER=faster_whisper
# OA_WHISPER_MODEL=large-v3-turbo
# OA_WHISPER_DEVICE=cuda
# OA_WHISPER_COMPUTE_TYPE=float16
# 固定识别语言可减少短片段语言检测错误；留空则自动检测
# OA_WHISPER_LANGUAGE=zh
# Windows 下 ctranslate2 需要 CUDA 12 + cuDNN 9 的 DLL（cublas64_12.dll 等）。
# 留空会自动探测：CUDA Toolkit、pip 的 nvidia-* 包、以及 DaVinci Resolve 等自带运行时；
# 也可显式指定（分号分隔）。GPU 仍不可用时 ASR 会自动回退 CPU int8。
OA_CUDA_DLL_DIRS=
# 低于该 RMS（0..1）的音频视为静音，不做 ASR/总结（避免 ASR 对静音产生幻觉）
OA_MIN_SPEECH_RMS=0.004
# 极短片段门控：短于该时长（秒）不做 pyannote 说话人分离，直接按单一说话人处理；
# 声纹 embedding 输入不足 min 秒时反射填充（避免 pyannote 在极短输入上 std/空均值告警）
OA_DIARIZATION_MIN_SECONDS=1.0
OA_EMBEDDING_MIN_SECONDS=0.5

# HuggingFace token（pyannote 模型下载）
# 注意：pyannote 的 speaker-diarization / embedding 是 gated 模型，
# 需要先用同一个 HF 账号在网页上接受使用条件，否则会 403：
#   https://hf.co/pyannote/speaker-diarization-3.1
#   https://hf.co/pyannote/segmentation-3.0
#   https://hf.co/pyannote/embedding
OA_HF_TOKEN=

# HuggingFace 下载镜像（国内网络强烈建议；留空则直连 huggingface.co）
# 也可配置可选缓存目录（默认 ~/.cache/huggingface）
OA_HF_ENDPOINT=
# OA_HF_HOME=./data/hf

# FunASR / ModelScope 模型缓存目录（留空默认 ~/.cache/modelscope）
# 建议指向部署目录，便于备份与离线部署
# OA_MODELSCOPE_CACHE=./data/modelscope

# pyannote 模型名（pyannote.audio 4 也可用 pyannote/speaker-diarization-community-1）
OA_DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
OA_EMBEDDING_MODEL=pyannote/embedding

# LLM（DeepSeek / 任意 OpenAI 兼容服务；留空则用规则总结）
OA_LLM_BASE_URL=https://api.deepseek.com/v1
OA_LLM_API_KEY=
OA_LLM_MODEL=deepseek-chat
OA_LLM_TIMEOUT_S=60

# 自实现搜索引擎（DuckDuckGo HTML）与查询超时
OA_SEARCH_BUILTIN_ENDPOINT=https://html.duckduckgo.com/html/
OA_SEARCH_TIMEOUT_S=15

# ── 钉钉自定义机器人 ──────────────────────────────────────────────────────────
# 群机器人 Webhook（含 access_token）与加签密钥（可选）
OA_DINGTALK_WEBHOOK=
OA_DINGTALK_SECRET=
OA_PUSH_ENABLED=true

# ── 业务参数 ─────────────────────────────────────────────────────────────────
# 声纹相似度阈值（0-100，越大越保守，默认 60）
OA_VOICEPRINT_THRESHOLD=60
# 用户画像最大长度（字符，提示词里全局生效）
OA_MAX_PROFILE_CHARS=600
# 每多少张新卡片增量修正一次画像
OA_PROFILE_UPDATE_EVERY=3
# 会议判定：最小时长（秒）与最少说话人数
OA_MEETING_MIN_SECONDS=60
OA_MEETING_MIN_SPEAKERS=2
# 总结丢弃策略：过于简短/无意义的人声音频允许 AI 选择丢弃（不生成卡片、不触发日程/待办/指令）
# 关闭后所有有转写的片段都会生成卡片；min_chars 是无 LLM 时的规则兜底阈值
OA_SUMMARIZER_DISCARD_ENABLED=true
OA_SUMMARIZER_DISCARD_MIN_CHARS=3
# 对话合并：转写完成后先等待一段时间，看是否还有时间相近的音频也完成转写；
# 有的话合并成一个对话，只生成一张卡片（避免把同一段对话切碎成多张卡片）。
OA_CONVERSATION_MERGE_ENABLED=true
# 转写完成后等待多久（秒）再总结
OA_CONVERSATION_MERGE_WINDOW_S=20
# 相邻片段录制时间间隔 ≤ 该值（秒）视为同一对话
OA_CONVERSATION_MERGE_GAP_S=45
# 单个对话最多合并的片段数 / 最大时长（秒），超出拆分为新对话
OA_CONVERSATION_MERGE_MAX_SEGMENTS=12
OA_CONVERSATION_MERGE_MAX_DURATION_S=900
# AI 定时复盘合并：后台每隔一段时间让 LLM 复盘近期新增卡片，把话题相同/时间相近的卡片
# 合并成一张并重新总结（片段级合并的补充；需要配置 LLM，否则自动跳过）。
OA_CARD_MERGE_ENABLED=true
OA_CARD_MERGE_INTERVAL_S=300
OA_CARD_MERGE_LOOKBACK_S=1800
OA_CARD_MERGE_MAX_CARDS=12
OA_CARD_MERGE_MAX_SPAN_S=3600
# 后台任务
OA_SCHEDULER_ENABLED=true
OA_WORKER_ENABLED=true
OA_JOB_POLL_SECONDS=1

# ── 演示模式 ─────────────────────────────────────────────────────────────────
# OA_DEMO_MODE=1 时强制使用离线 mock providers（即使已安装 funasr/faster-whisper/pyannote/torch），
# 并允许 meta.demo_turns 演示数据。生产环境务必设为 0。
OA_DEMO_MODE=0
