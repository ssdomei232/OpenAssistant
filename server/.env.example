# ──────────────────────────────────────────────────────────────────────────────
# OpenAssistant Server 配置示例（复制为 server/.env 后修改）
# 所有变量都以 OA_ 开头，环境变量优先级高于 .env
# ──────────────────────────────────────────────────────────────────────────────

# 基础
OA_ENVIRONMENT=development
OA_DEBUG=false
OA_PUBLIC_BASE_URL=http://192.168.1.10:8000

# 数据库：SQLite（默认，适合个人部署）或 PostgreSQL
# OA_DATABASE_URL=sqlite:///./data/openassistant.db
# OA_DATABASE_URL=postgresql+psycopg://openassistant:password@localhost:5432/openassistant

# 对象存储（音频文件）
OA_STORAGE_DIR=./data/storage

# 认证
# 生成 API Key：python -m app.cli create-user --name 小明
# 若设置下面的值，服务启动时会自动创建/复用该 Key 对应的用户（仅开发用）
OA_BOOTSTRAP_API_KEY=
OA_BOOTSTRAP_USER_NAME=我
OA_API_KEY_PEPPER=change-me-in-production

# ── Providers ─────────────────────────────────────────────────────────────────
# auto：检测到依赖/密钥就用真实实现，否则自动降级（mock/rule/energy/spectral）
OA_ASR_PROVIDER=auto
OA_DIARIZATION_PROVIDER=auto
OA_SPEAKER_PROVIDER=auto
OA_LLM_PROVIDER=auto
OA_SEARCH_PROVIDER=auto
OA_PUSH_PROVIDER=auto

# ASR
OA_WHISPER_MODEL=large-v3-turbo
OA_WHISPER_DEVICE=cuda
OA_WHISPER_COMPUTE_TYPE=float16

# HuggingFace token（pyannote 模型下载）
# 注意：pyannote 的 speaker-diarization / embedding 是 gated 模型，
# 需要先用同一个 HF 账号在网页上接受使用条件，否则会 403：
#   https://hf.co/pyannote/speaker-diarization-3.1
#   https://hf.co/pyannote/segmentation-3.0
#   https://hf.co/pyannote/embedding
OA_HF_TOKEN=

# HuggingFace 下载镜像（国内网络强烈建议；留空则直连 huggingface.co）
# 也可配置可选缓存目录（默认 ~/.cache/huggingface）
OA_HF_ENDPOINT=
# OA_HF_HOME=./data/hf

# pyannote 模型名（pyannote.audio 4 也可用 pyannote/speaker-diarization-community-1）
OA_DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
OA_EMBEDDING_MODEL=pyannote/embedding

# LLM（DeepSeek / 任意 OpenAI 兼容服务；留空则用规则总结）
OA_LLM_BASE_URL=https://api.deepseek.com/v1
OA_LLM_API_KEY=
OA_LLM_MODEL=deepseek-chat
OA_LLM_TIMEOUT_S=60

# 自实现搜索引擎（DuckDuckGo HTML）与查询超时
OA_SEARCH_BUILTIN_ENDPOINT=https://html.duckduckgo.com/html/
OA_SEARCH_TIMEOUT_S=15

# ── 钉钉自定义机器人 ──────────────────────────────────────────────────────────
# 群机器人 Webhook（含 access_token）与加签密钥（可选）
OA_DINGTALK_WEBHOOK=
OA_DINGTALK_SECRET=
OA_PUSH_ENABLED=true

# ── 业务参数 ─────────────────────────────────────────────────────────────────
# 声纹相似度阈值（0-100，越大越保守，默认 60）
OA_VOICEPRINT_THRESHOLD=60
# 用户画像最大长度（字符，提示词里全局生效）
OA_MAX_PROFILE_CHARS=600
# 每多少张新卡片增量修正一次画像
OA_PROFILE_UPDATE_EVERY=3
# 会议判定：最小时长（秒）与最少说话人数
OA_MEETING_MIN_SECONDS=60
OA_MEETING_MIN_SPEAKERS=2
# 后台任务
OA_SCHEDULER_ENABLED=true
OA_WORKER_ENABLED=true
OA_JOB_POLL_SECONDS=1

# ── 演示模式 ─────────────────────────────────────────────────────────────────
# OA_DEMO_MODE=1 时强制使用离线 mock providers（即使已安装 faster-whisper/pyannote/torch），
# 并允许 meta.demo_turns 演示数据。生产环境务必设为 0。
OA_DEMO_MODE=0
